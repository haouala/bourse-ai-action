# Bourse AI local development — copy to .env and edit before running.
# NEVER commit .env or expose port 8081 publicly without authentication.
SERVER_PORT=8081
SERVER_BIND_ADDRESS=127.0.0.1

# Local Docker PostgreSQL 17 on 127.0.0.1:5434; the volume persists between runs.
DB_URL=jdbc:postgresql://127.0.0.1:5434/bourse_ai
# Set false when you already run PostgreSQL with these credentials.
START_POSTGRES=true
DB_USER=bourse
# REQUIRED: set a strong password here (change ONLY before the first Docker database creation).
DB_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# Research orchestrator: consumes ALREADY IMPORTED canonical daily closes.
# Off until validated locally. Does NOT spend provider credits itself.
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_MAX_PER_TICK=5
ORCHESTRATOR_DELAY_MS=300000

# Do not enable external polling until credentials, budgets and data rights are verified.
MARKET_SCHEDULER_ENABLED=false
INFORMATION_SCHEDULER_ENABLED=false
INFORMATION_AI_ENABLED=false
SOCIAL_X_ENABLED=false
TWELVE_DATA_API_KEY=
EODHD_API_KEY=
FMP_API_KEY=
SEC_USER_AGENT=
TWELVE_DATA_DAILY_LIMIT=780
TWELVE_DATA_MINUTE_LIMIT=8
EODHD_DAILY_LIMIT=18
EODHD_MINUTE_LIMIT=20
FMP_DAILY_LIMIT=240
FMP_MINUTE_LIMIT=5

# Optional: news and podcast analysis worker (must be separately started).
INFORMATION_MINIMUM_INTERVAL_SECONDS=3600
INFORMATION_AI_LOOKBACK_DAYS=7
INFORMATION_AI_MODEL=gpt-5.4-mini-2026-03-17
INFORMATION_WORKER_TOKEN=
INFORMATION_REVIEW_TOKEN=
