# Exemple documentaire uniquement : Python ne charge pas ce fichier automatiquement.
# Définir ces variables dans le terminal, ou utiliser le fichier pgpass de libpq.
PGHOST=127.0.0.1
PGPORT=5434
PGDATABASE=bourse_ai
PGUSER=bourse
# PGPASSWORD=your-local-password (ne jamais committer un vrai mot de passe)
# Pour un serveur distant avec TLS : PGSSLMODE=verify-full et PGSSLROOTCERT=...
# Alternative facultative, uniquement dans l'environnement, jamais dans la ligne de commande :
# BOURSE_ML_DSN=host=127.0.0.1 port=5434 dbname=bourse_ai user=bourse
