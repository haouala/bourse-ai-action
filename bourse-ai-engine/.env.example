# Copy to .env and fill in locally. Never commit .env.
TWELVE_DATA_API_KEY=
EODHD_API_KEY=
# Optional providers
FMP_API_KEY=
SEC_USER_AGENT=
# HTTP port
SERVER_PORT=8081
# Optional lower budgets. Zero disables a provider.
TWELVE_DATA_DAILY_LIMIT=780
TWELVE_DATA_MINUTE_LIMIT=8
EODHD_DAILY_LIMIT=18
EODHD_MINUTE_LIMIT=20
FMP_DAILY_LIMIT=240
FMP_MINUTE_LIMIT=5
# PostgreSQL only: adapt these to your local database
DB_URL=jdbc:postgresql://127.0.0.1:5434/bourse_ai
DB_USER=bourse
DB_PASSWORD=

# The 15-minute scheduler spends provider credits. Enable only after verifying access and budget.
MARKET_SCHEDULER_ENABLED=false
MARKET_WORKER_DELAY_MS=10000
PORTFOLIO_MONITOR_DELAY_MS=60000
# Social collection is opt-in; a separate paid API may be required.
SOCIAL_X_ENABLED=false
SOCIAL_X_BEARER_TOKEN=
SOCIAL_X_MONTHLY_POST_LIMIT=0

# Public RSS/Atom sources need no token. Enable each source via REST before collecting.
INFORMATION_SCHEDULER_ENABLED=false
INFORMATION_MINIMUM_INTERVAL_SECONDS=3600
INFORMATION_SCHEDULER_DELAY_MS=60000
# Optional trusted local source catalog. Keep default unless you maintain that file.
# INFORMATION_CATALOG=file:/absolute/path/information-sources.json
