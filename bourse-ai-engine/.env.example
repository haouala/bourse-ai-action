# Copy to .env and fill in locally. Never commit .env.
TWELVE_DATA_API_KEY=
EODHD_API_KEY=
# Optional providers
FMP_API_KEY=
SEC_USER_AGENT=
# HTTP port
SERVER_PORT=8081
# Optional lower budgets. Zero disables a provider.
TWELVE_DATA_DAILY_LIMIT=780
TWELVE_DATA_MINUTE_LIMIT=8
EODHD_DAILY_LIMIT=18
EODHD_MINUTE_LIMIT=20
FMP_DAILY_LIMIT=240
FMP_MINUTE_LIMIT=5
# PostgreSQL only: adapt these to your local database
DB_URL=jdbc:postgresql://127.0.0.1:5434/bourse_ai
DB_USER=bourse
DB_PASSWORD=
